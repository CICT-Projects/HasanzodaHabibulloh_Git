@{
    ViewData["Title"] = "Система управления складом";
}

<div class="container-fluid mt-5">
    <!-- Заголовок -->
    <div class="row mb-5">
        <div class="col-12">
            <div class="text-center">
                <h1 class="display-4 fw-bold">
                    <i class="bi bi-box-seam"></i> Система управления складом
                </h1>
                <p class="lead text-muted">Управление автомобильными запчастями</p>
            </div>
        </div>
    </div>

    <!-- Карточки модулей -->
    <div class="row g-4">
        <!-- Карточка: Шины -->
        <div class="col-md-6 col-lg-3">
            <div class="card shadow-sm h-100 border-0 transition-scale">
                <div class="card-body text-center">
                    <div class="icon-circle bg-primary mb-3 mx-auto">
                        <i class="bi bi-circle-fill text-white fs-2" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); padding: 20px; border-radius: 50%; width: 80px; height: 80px; display: flex; align-items: center; justify-content: center;">
                            <i class="bi bi-bicycle" style="color: white; font-size: 2rem;"></i>
                        </i>
                    </div>
                    <h5 class="card-title fw-bold">Шины</h5>
                    <p class="card-text text-muted small">Управление шинами и покрышками</p>
                </div>
                <div class="card-footer bg-transparent border-top-0">
                    <a asp-controller="Tires" asp-action="Index" class="btn btn-outline-primary btn-sm w-100 mb-2">
                        <i class="bi bi-list"></i> Открыть список
                    </a>
                    <a asp-controller="Tires" asp-action="Create" class="btn btn-primary btn-sm w-100">
                        <i class="bi bi-plus-lg"></i> Добавить новую
                    </a>
                </div>
            </div>
        </div>

        <!-- Карточка: Масла -->
        <div class="col-md-6 col-lg-3">
            <div class="card shadow-sm h-100 border-0 transition-scale">
                <div class="card-body text-center">
                    <div class="icon-circle bg-success mb-3 mx-auto">
                        <i class="bi bi-circle-fill text-white fs-2" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); padding: 20px; border-radius: 50%; width: 80px; height: 80px; display: flex; align-items: center; justify-content: center;">
                            <i class="bi bi-droplet-fill" style="color: white; font-size: 2rem;"></i>
                        </i>
                    </div>
                    <h5 class="card-title fw-bold">Масла</h5>
                    <p class="card-text text-muted small">Управление маслами и жидкостями</p>
                </div>
                <div class="card-footer bg-transparent border-top-0">
                    <a asp-controller="Oils" asp-action="Index" class="btn btn-outline-success btn-sm w-100 mb-2">
                        <i class="bi bi-list"></i> Открыть список
                    </a>
                    <a asp-controller="Oils" asp-action="Create" class="btn btn-success btn-sm w-100">
                        <i class="bi bi-plus-lg"></i> Добавить новое
                    </a>
                </div>
            </div>
        </div>

        <!-- Карточка: Аккумуляторы -->
        <div class="col-md-6 col-lg-3">
            <div class="card shadow-sm h-100 border-0 transition-scale">
                <div class="card-body text-center">
                    <div class="icon-circle bg-warning mb-3 mx-auto">
                        <i class="bi bi-circle-fill text-white fs-2" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%); padding: 20px; border-radius: 50%; width: 80px; height: 80px; display: flex; align-items: center; justify-content: center;">
                            <i class="bi bi-battery-charging" style="color: white; font-size: 2rem;"></i>
                        </i>
                    </div>
                    <h5 class="card-title fw-bold">Аккумуляторы</h5>
                    <p class="card-text text-muted small">Управление аккумуляторными батареями</p>
                </div>
                <div class="card-footer bg-transparent border-top-0">
                    <a asp-controller="Batteries" asp-action="Index" class="btn btn-outline-warning btn-sm w-100 mb-2">
                        <i class="bi bi-list"></i> Открыть список
                    </a>
                    <a asp-controller="Batteries" asp-action="Create" class="btn btn-warning btn-sm w-100">
                        <i class="bi bi-plus-lg"></i> Добавить новый
                    </a>
                </div>
            </div>
        </div>

        <!-- Карточка: Фильтры -->
        <div class="col-md-6 col-lg-3">
            <div class="card shadow-sm h-100 border-0 transition-scale">
                <div class="card-body text-center">
                    <div class="icon-circle bg-danger mb-3 mx-auto">
                        <i class="bi bi-circle-fill text-white fs-2" style="background: linear-gradient(135deg, #fa709a 0%, #fee140 100%); padding: 20px; border-radius: 50%; width: 80px; height: 80px; display: flex; align-items: center; justify-content: center;">
                            <i class="bi bi-funnel-fill" style="color: white; font-size: 2rem;"></i>
                        </i>
                    </div>
                    <h5 class="card-title fw-bold">Фильтры</h5>
                    <p class="card-text text-muted small">Управление воздушными и масляными фильтрами</p>
                </div>
                <div class="card-footer bg-transparent border-top-0">
                    <a asp-controller="Filters" asp-action="Index" class="btn btn-outline-danger btn-sm w-100 mb-2">
                        <i class="bi bi-list"></i> Открыть список
                    </a>
                    <a asp-controller="Filters" asp-action="Create" class="btn btn-danger btn-sm w-100">
                        <i class="bi bi-plus-lg"></i> Добавить новый
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .transition-scale {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .transition-scale:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15) !important;
    }

    .card-footer .btn {
        transition: all 0.2s ease;
    }

    .card-footer .btn:hover {
        transform: translateX(2px);
    }
</style>
