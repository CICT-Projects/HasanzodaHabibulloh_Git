@model backend.Models.Battery

@{
    ViewData["Title"] = "Просмотр аккумулятора";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8">
            <h1>@ViewData["Title"]</h1>
            <hr />

            <dl class="row">
                <dt class="col-sm-3">Артикул</dt>
                <dd class="col-sm-9">@Model.Article</dd>

                <dt class="col-sm-3">Название</dt>
                <dd class="col-sm-9">@Model.Name</dd>

                <dt class="col-sm-3">Цена</dt>
                <dd class="col-sm-9">@Model.Price.ToString("C")</dd>

                <dt class="col-sm-3">Количество</dt>
                <dd class="col-sm-9">@Model.Quantity</dd>

                <dt class="col-sm-3">Напряжение</dt>
                <dd class="col-sm-9">@Model.VoltageV V</dd>

                <dt class="col-sm-3">Емкость</dt>
                <dd class="col-sm-9">@Model.CapacityAh Ач</dd>

                <dt class="col-sm-3">Дата создания</dt>
                <dd class="col-sm-9">@Model.CreatedAt.ToString("g")</dd>
            </dl>

            <div class="mt-4">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                    <i class="bi bi-pencil"></i> Редактировать
                </a>
                <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">
                    <i class="bi bi-trash"></i> Удалить
                </a>
                <a asp-action="Index" class="btn btn-secondary">Вернуться к списку</a>
            </div>
        </div>
    </div>
</div>
