@model IEnumerable<backend.Models.Tire>

@{
    ViewData["Title"] = "Шины";
}

<div class="container mt-4">
    <div class="row mb-3">
        <div class="col-md-8">
            <h1 class="display-5">@ViewData["Title"]</h1>
        </div>
        <div class="col-md-4 text-end">
            <a asp-action="Create" class="btn btn-success">
                <i class="bi bi-plus"></i> Добавить новую
            </a>
        </div>
    </div>

    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Артикул</th>
                        <th>Название</th>
                        <th>Цена</th>
                        <th>Количество</th>
                        <th>Диаметр (дюйм)</th>
                        <th>Профиль</th>
                        <th>Дата создания</th>
                        <th>Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Article</td>
                            <td>@item.Name</td>
                            <td>@item.Price.ToString("C")</td>
                            <td>
                                <span class="badge bg-@(item.Quantity > 5 ? "success" : "warning")">
                                    @item.Quantity
                                </span>
                            </td>
                            <td>@item.DiameterInches"</td>
                            <td>@item.ProfileDescription</td>
                            <td>@item.CreatedAt.ToString("g")</td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-primary" title="Редактировать">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info" title="Просмотр">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger" title="Удалить">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> Нет данных для отображения.
            <a asp-action="Create" class="alert-link">Добавить первую запись</a>
        </div>
    }
</div>
