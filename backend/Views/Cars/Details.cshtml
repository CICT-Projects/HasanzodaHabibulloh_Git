@model backend.Models.Car

@{
    ViewData["Title"] = "Просмотр автомобиля";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8">
            <h1>@ViewData["Title"]</h1>
            <hr />

            <dl class="row">
                <dt class="col-sm-3">Марка</dt>
                <dd class="col-sm-9">@Model.Brand</dd>

                <dt class="col-sm-3">Модель</dt>
                <dd class="col-sm-9">@Model.Model</dd>

                <dt class="col-sm-3">Год выпуска</dt>
                <dd class="col-sm-9">@Model.Year</dd>

                <dt class="col-sm-3">Цвет</dt>
                <dd class="col-sm-9">
                    <span class="badge" style="background-color: @(Model.Color ?? "gray")">
                        @Model.Color
                    </span>
                </dd>
            </dl>

            <div class="mt-4">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                    <i class="bi bi-pencil"></i> Редактировать
                </a>
                <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">
                    <i class="bi bi-trash"></i> Удалить
                </a>
                <a asp-action="Index" class="btn btn-secondary">Вернуться к списку</a>
            </div>
        </div>
    </div>
</div>
