@model backend.Models.Car

@{
    ViewData["Title"] = "Редактировать автомобиль";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8">
            <h1>@ViewData["Title"]</h1>
            <hr />

            <form asp-action="Edit" method="post" class="needs-validation" novalidate>
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <input type="hidden" asp-for="Id" />

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="Brand" class="form-label">Марка</label>
                        <input asp-for="Brand" class="form-control" />
                        <span asp-validation-for="Brand" class="invalid-feedback"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Model" class="form-label">Модель</label>
                        <input asp-for="Model" class="form-control" />
                        <span asp-validation-for="Model" class="invalid-feedback"></span>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="Year" class="form-label">Год выпуска</label>
                        <input asp-for="Year" type="number" class="form-control" />
                        <span asp-validation-for="Year" class="invalid-feedback"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Color" class="form-label">Цвет</label>
                        <input asp-for="Color" class="form-control" />
                        <span asp-validation-for="Color" class="invalid-feedback"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <button type="submit" class="btn btn-success">Сохранить изменения</button>
                    <a asp-action="Index" class="btn btn-secondary">Отмена</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
